# Copy this file to config.env and adjust for your server.
# health_monitor.sh sources this file automatically if present.

CPU_THRESHOLD=85
MEM_THRESHOLD=90
DISK_THRESHOLD=85
SWAP_THRESHOLD=50

# Space-separated list of mount points to check
DISK_MOUNTS="/ /var /home"

# Optional: Slack or Microsoft Teams incoming webhook URL.
# Leave blank to disable webhook alerts (local log-only mode).
WEBHOOK_URL=""
